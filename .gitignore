# ==============================================================================
# SG Finance Suite — .gitignore
# ==============================================================================

# Environment Variables
# Ignore all .env files; keep .env.example as a committed template.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build Output
# Vite renderer bundle, compiled Electron main/preload, and electron-builder
# packaged output are all generated artefacts — never commit them.
dist/
dist-electron/
build/
out/
release/*
!release/SG_Finance_Suite.exe

# Electron Build Artefacts
# Packaged binaries and the asar archive produced by electron-builder.
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.asar
!release/SG_Finance_Suite.exe

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache

# Test Output
coverage/
playwright-report/
test-results/

# IDEs & Editors
.vscode/
.idea/

# OS-Generated Files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary Files
tmp/
temp/
*.tmp

# Python
__pycache__/
*.pyc

# Runtime
*.pid

# Local Databases
*.sqlite
*.sqlite3

# Certificates & Private Keys
*.pem
*.key
*.crt
*.p12

# Local Configuration
# Covers Vite's *.env.local pattern and any other machine-local overrides.
*.local

# Miscellaneous Generated Files
*.bak
*.old
*.orig
